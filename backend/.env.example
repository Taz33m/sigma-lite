# Database (SQLite for local development - no PostgreSQL needed!)
DATABASE_URL=sqlite:///./sigmalite.db
TEST_DATABASE_URL=sqlite:///./test_sigmalite.db

# Redis
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_BACKEND=auto

# JWT
# Generate locally with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# File Upload
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes
UPLOAD_DIR=./uploads

# Environment
ENVIRONMENT=development
DEBUG=True
ENABLE_OTEL=False
EXPOSE_API_DOCS=False
EXPOSE_PUBLIC_METRICS=False
METRICS_TOKEN=
TRUST_PROXY_CLIENT_IP_HEADER=

# Public-beta resource caps
MAX_EXPORT_ROWS=100000
MAX_FORMULA_LENGTH=512
MAX_FORMULA_EVAL_ROWS=100000
WS_TICKET_TTL_SECONDS=60

# Authentication
# WARNING: Setting this to True bypasses all authentication and routes every
# request through a hardcoded demo user. Use ONLY for local development/testing.
# Never enable in any environment that is reachable from the internet.
DISABLE_AUTH=False
